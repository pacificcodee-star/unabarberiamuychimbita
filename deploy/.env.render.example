# Variables que debes pegar en Render (Environment) porque son secretas
# o dependen de la URL final. Las demás ya están en render.yaml.

# APP_URL = https://TU-SERVICIO.onrender.com  (aparece al crear el servicio)
# Render termina TLS y sanea X-Forwarded-For; Laravel confía solo en el proxy inmediato de Caddy.
TRUSTED_PROXIES=REMOTE_ADDR
# EVOLUTION_URL = https://TU-SERVICIO.onrender.com/evolution
#   (sin barra final; el panel la usa como base para /instance/connect, etc.)

# Genera el APP_KEY con:  php artisan key:generate --show
APP_KEY=base64:...

# La misma clave para la API de Evolution y para firmar su webhook
EVOLUTION_APIKEY=pon-aqui-una-clave-larga-aleatoria
EVOLUTION_WEBHOOK_SECRET=pon-aqui-la-misma-clave

# Base de datos PostgreSQL externa (Neon free). Neon entrega algo como:
#   postgresql://usuario:clave@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_URL=postgresql://usuario:clave@host/neondb?sslmode=require
DATABASE_CONNECTION_URI=postgresql://usuario:clave@host/neondb?sslmode=require
