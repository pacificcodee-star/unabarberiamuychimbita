# Variante local (sin HTTPS ni dominio): Caddy sirve HTTP plano en el puerto 80 del contenedor.
:80 {
	root * /var/www/html/public
	@whatsappSocket {
		method GET
		path /whatsapp-live/app/*
		header Upgrade websocket
	}
	handle @whatsappSocket {
		uri strip_prefix /whatsapp-live
		reverse_proxy 127.0.0.1:8091
	}
	# Nunca ejecutar PHP subido: solo public/index.php pasa a PHP.
	@noPhpStorage path /storage/* /images/* /videos/* /icons/* /vendor/* /css/* /js/*
	handle @noPhpStorage {
		header X-Content-Type-Options nosniff
		file_server
	}
	# Peticiones de más de 120 MB se cortan antes de llegar a PHP.
	request_body {
		max_size 120MB
	}
	encode gzip
	php_fastcgi 127.0.0.1:9000
	file_server
}
