# Copia este archivo como ".env" en esta misma carpeta.
# Puedes hacerlo a mano o simplemente ejecutar ./deploy.sh (lo genera con secretos aleatorios).

# Dominios públicos. Sin dominio propio, usa sslip.io con la IP de tu VPS:
#   203.113.10.7  ->  barberia.203.113.10.7.sslip.io  y  wa.203.113.10.7.sslip.io
APP_HOST=barberia.TU_IP.sslip.io
WA_HOST=wa.TU_IP.sslip.io

# Clave de la app Laravel en formato base64. Si la dejas vacía, deploy.sh genera una.
APP_KEY=

# Base de datos del panel (MySQL)
DB_PASSWORD=CAMBIA_ESTO
DB_ROOT_PASSWORD=CAMBIA_ESTO

# Evolution API: esta clave protege la API y también valida los webhooks entrantes.
EVOLUTION_APIKEY=CAMBIA_ESTO

# Base de datos interna de Evolution (PostgreSQL)
EVOLUTION_DB_PASSWORD=CAMBIA_ESTO

# Notificaciones push del panel. Genera claves con:
#   docker compose exec web php artisan barberia:push-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@example.com

# Google (opcional). Código de la etiqueta HTML de Search Console (solo el valor de content="...").
GOOGLE_SITE_VERIFICATION=
# Enlace a la ficha de Google Business Profile y enlace para dejar reseña.
GOOGLE_BUSINESS_URL=
GOOGLE_REVIEW_URL=
# Google Analytics 4 (G-XXXXXXX). Si lo pones, vuelve a salir el aviso de cookies para pedir permiso.
ANALYTICS_GA4_ID=
