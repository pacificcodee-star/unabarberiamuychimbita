APP_NAME="Una Barberia Muy Chimbita"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barberia
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps (Contacto): clave de la API oficial
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Notificaciones push (Web Push). Genera las claves con: php artisan barberia:push-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@ejemplo.com

# Fila automática de turnos
TURN_GRACE_MINUTES=10
TURN_AUTO_QUEUE=true

# WhatsApp — Evolution API (canal activo: avisos, chat y bot automáticos)
# Docs: docs/WHATSAPP.md · Panel: /whatsapp (solo administrador)
WHATSAPP_DRIVER=evolution
EVOLUTION_URL=
EVOLUTION_APIKEY=
EVOLUTION_INSTANCE=barberia
EVOLUTION_WEBHOOK_SECRET=
WHATSAPP_BOT_ENABLED=true
WHATSAPP_DEFAULT_COUNTRY=57

# WhatsApp Business Platform de Meta (solo si WHATSAPP_DRIVER=cloud)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=es_CO
WHATSAPP_TPL_TURN_CONFIRMED=
WHATSAPP_TPL_TURN_NEXT=
WHATSAPP_TPL_TURN_CALLED=
WHATSAPP_TPL_APPT_BOOKED=
WHATSAPP_TPL_APPT_REMINDER=
WHATSAPP_TPL_CANCELLED=
