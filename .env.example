APP_NAME="Una Barberia Muy Chimbita"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barberia
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps (Contacto): clave de la API oficial
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Notificaciones push (Web Push). Genera las claves con: php artisan barberia:push-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@ejemplo.com

# Fila automática de turnos
TURN_GRACE_MINUTES=10
TURN_AUTO_QUEUE=true

# WhatsApp — Evolution API (canal activo: avisos, chat y bot automáticos)
# Docs: docs/WHATSAPP.md · Panel: /whatsapp (solo administrador)
WHATSAPP_DRIVER=evolution
EVOLUTION_URL=
EVOLUTION_APIKEY=
EVOLUTION_INSTANCE=barberia
EVOLUTION_WEBHOOK_SECRET=
# Opcional: URL interna del webhook si Evolution corre junto a Laravel (vacío = APP_URL)
EVOLUTION_WEBHOOK_URL=
WHATSAPP_BOT_ENABLED=true
WHATSAPP_DEFAULT_COUNTRY=57

# WhatsApp Business Platform de Meta (solo si WHATSAPP_DRIVER=cloud)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=es_CO
WHATSAPP_TPL_TURN_CONFIRMED=
WHATSAPP_TPL_TURN_NEXT=
WHATSAPP_TPL_TURN_CALLED=
WHATSAPP_TPL_APPT_BOOKED=
WHATSAPP_TPL_APPT_REMINDER=
WHATSAPP_TPL_CANCELLED=

# --- Sitio público: legal, HTTPS, analítica y Google (config/web.php) ---
# Redirige http → https y envía HSTS. Por defecto activo solo con APP_ENV=production.
# FORCE_HTTPS=true
# Titular del sitio para el aviso legal y la política de datos (Ley 1581 de 2012).
LEGAL_OWNER=
LEGAL_NIT=
LEGAL_EMAIL=
LEGAL_UPDATED_AT=2026-11-21
# Google Analytics 4 (G-XXXXXXXXXX). Solo se carga si el visitante acepta las cookies.
ANALYTICS_GA4_ID=
# Ficha de Google Business Profile y enlace para dejar reseñas (https://g.page/r/XXXX/review).
GOOGLE_BUSINESS_URL=
GOOGLE_REVIEW_URL=
# Código de verificación de Google Search Console (solo el valor de content="...").
GOOGLE_SITE_VERIFICATION=

# --- Seguridad y monitoreo ---
# En producción: APP_ENV=production y APP_DEBUG=false (nunca true: mostraría código y consultas).
# Cookie de sesión solo por HTTPS (por defecto activo con APP_ENV=production).
# SESSION_SECURE_COOKIE=true
# Los datos de demostración (usuarios con contraseña "password") no se cargan en producción salvo que pongas esto.
# ALLOW_DEMO_SEED=false
# Días que vive el enlace de seguimiento del cliente después de la fecha de su cita o turno.
TRACK_LINK_DAYS=30
# Retención de registros: auditoría del panel y errores del navegador (storage/logs).
LOG_AUDIT_DAYS=90
LOG_BROWSER_DAYS=14
# Alertas: para recibir los errores críticos en Slack, usa LOG_STACK=daily,slack y LOG_SLACK_WEBHOOK_URL.
# LOG_SLACK_WEBHOOK_URL=
# Monitoreo externo: apunta UptimeRobot o similar a https://TU-DOMINIO/salud (503 si la base o la tarea programada fallan).
